# Cadence configuration reference. Copy to .env and fill in what you use.
# Every integration below is OPTIONAL: Cadence starts and serves search/browsing even with
# none of them configured, surfacing "not configured" rather than failing to boot.
#
# Prowlarr/qBittorrent/slskd/Spotify/library fields can also be set (or changed) from the
# admin Settings page in the web UI, with no restart required. An env var set here always
# takes precedence over a value saved through that page, so this file remains the way to pin
# a fixed, non-UI-editable configuration if you prefer. Secrets saved via the UI are encrypted
# at rest using a key generated on first boot and persisted to DATA_DIR/settings_encryption.key
# (owner-only permissions), the same pattern SESSION_SECRET uses.

# --- Core ---
DEMO_MODE=false
DATA_DIR=./data
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/cadence.db

# --- Auth / sessions ---
# SESSION_SECRET is generated on first boot and persisted to DATA_DIR if left unset.
# SESSION_SECRET=
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-first-boot
SESSION_TTL_MINUTES=10080
# Set to false ONLY if you serve Cadence over plain HTTP (e.g. a LAN or Tailscale IP with no
# reverse proxy). Browsers never send Secure cookies over plain HTTP (localhost excepted), and
# the session cookie is what authenticates the Spotify connect flow and live search, so those
# two show "Not authenticated" on a plain-HTTP deploy until this is disabled.
COOKIE_SECURE=true

# --- Prowlarr (indexer aggregator) ---
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=

# --- qBittorrent ---
# QBITTORRENT_URL=http://qbittorrent:8080
# QBITTORRENT_USERNAME=
# QBITTORRENT_PASSWORD=

# --- slskd (Soulseek daemon) ---
# SLSKD_URL=http://slskd:5030
# SLSKD_API_KEY=

# --- ytdlp-shim (last-resort YouTube audio fallback) ---
# A separate, isolated service (ytdlp-shim/), not part of this image: yt-dlp's YouTube
# extractor breaks on YouTube's own schedule, and process isolation keeps that from ever
# touching Cadence's own process. Tried only after Prowlarr and slskd both come up empty.
# YTDLP_SHIM_URL=http://ytdlp-shim:8090

# --- Navidrome (sign-in backend, optional) ---
# Set this and your library's users can log into Cadence with the username and password they
# already use for Navidrome, instead of you handing out a second set of credentials. Their
# Navidrome admin flag is mirrored across, so Navidrome admins are Cadence admins.
# Local accounts keep working either way, and are tried first so you are never locked out of
# Cadence while Navidrome is down. Leave unset for local accounts only.
# NAVIDROME_URL=http://navidrome:4533

# Optional Navidrome service account, used only to tell a requester that a track is ALREADY in
# your library before they queue a download of it. This cannot reuse the requesting user's own
# credential: Cadence never stores a Navidrome password, so there is nothing to replay outside
# a login. An ordinary (non-admin) Navidrome account is enough, since the check only reads.
# Leave unset and the library badges simply never appear; sign-in, search and fulfillment are
# all unaffected.
# NAVIDROME_ADMIN_USER=
# NAVIDROME_ADMIN_PASSWORD=

# --- Spotify (Client Credentials app-only search tab) ---
# Register an app at https://developer.spotify.com/dashboard to get these.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# --- Public base URL ---
# Required only for the opt-in "Your Spotify" personalization tab (per-user Authorization Code
# OAuth, connecting a user's own saved tracks/playlists as a quick-pick source): used to build
# the Spotify OAuth redirect_uri (<APP_BASE_URL>/api/spotify/callback). Must match a Redirect
# URI registered on the same Spotify app as SPOTIFY_CLIENT_ID/SECRET above. Not needed if you
# never use that tab; the app-only search tab and everything else work without it.
# APP_BASE_URL=https://cadence.example.com

# --- Library ---
MUSIC_LIBRARY_PATH=./data/library
LIBRARY_PATH_PATTERN={artist}/{title}.{ext}

# --- Fulfillment tuning ---
FULFILLMENT_PROWLARR_ATTEMPT_BUDGET=5
FULFILLMENT_POLL_INTERVAL_SECONDS=10
FULFILLMENT_DOWNLOAD_TIMEOUT_SECONDS=900

# --- Outbound HTTP behavior ---
OUTBOUND_TIMEOUT_SECONDS=8.0
OUTBOUND_MAX_RETRIES=2

# --- CORS (only needed if serving the web client from a different origin) ---
CORS_ALLOW_ORIGINS=
