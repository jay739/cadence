# Cadence configuration reference. Copy to .env and fill in what you use.
# Every integration below is OPTIONAL: Cadence starts and serves search/browsing even with
# none of them configured, surfacing "not configured" rather than failing to boot.

# --- Core ---
DEMO_MODE=false
DATA_DIR=./data
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/cadence.db

# --- Auth / sessions ---
# SESSION_SECRET is generated on first boot and persisted to DATA_DIR if left unset.
# SESSION_SECRET=
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-first-boot
SESSION_TTL_MINUTES=10080

# --- Prowlarr (indexer aggregator) ---
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=

# --- qBittorrent ---
# QBITTORRENT_URL=http://qbittorrent:8080
# QBITTORRENT_USERNAME=
# QBITTORRENT_PASSWORD=

# --- slskd (Soulseek daemon) ---
# SLSKD_URL=http://slskd:5030
# SLSKD_API_KEY=

# --- Spotify (Client Credentials app-only search tab) ---
# Register an app at https://developer.spotify.com/dashboard to get these.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# --- Library ---
MUSIC_LIBRARY_PATH=./data/library
LIBRARY_PATH_PATTERN={artist}/{title}.{ext}

# --- Fulfillment tuning ---
FULFILLMENT_PROWLARR_ATTEMPT_BUDGET=5
FULFILLMENT_POLL_INTERVAL_SECONDS=10
FULFILLMENT_DOWNLOAD_TIMEOUT_SECONDS=900

# --- Outbound HTTP behavior ---
OUTBOUND_TIMEOUT_SECONDS=8.0
OUTBOUND_MAX_RETRIES=2

# --- CORS (only needed if serving the web client from a different origin) ---
CORS_ALLOW_ORIGINS=
